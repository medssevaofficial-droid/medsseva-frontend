{
  "expo": {
    "name": "medsseva",
    "slug": "medsseva-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/adaptive-icon.png",
    "scheme": "medssevaapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kanha0415.medssevaapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/adaptive-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#006D6F",
          "dark": {
            "backgroundColor": "#005255"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-google-signin/google-signin",
      "./plugins/fixFirebaseMessagingManifest.js",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MedSeva needs access to your photos to upload prescriptions.",
          "cameraPermission": "MedSeva needs access to your camera to capture prescriptions."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MedSeva uses your location to show nearby branches and assign the closest sample collection partner.",
          "locationWhenInUsePermission": "MedSeva uses your location to show nearby branches and assign the closest sample collection partner.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#006D6F",
          "sounds": [],
          "mode": "production",
          "androidMode": "default",
          "androidCollapsedTitle": "MedSeva",
          "androidChannels": [
            {
              "name": "general",
              "importance": 4,
              "vibrationPattern": [
                0,
                250,
                250,
                250
              ],
              "lightColor": "#006D6F"
            },
            {
              "name": "bookings",
              "importance": 5,
              "vibrationPattern": [
                0,
                250,
                250,
                250
              ],
              "lightColor": "#006D6F"
            },
            {
              "name": "reports",
              "importance": 4,
              "vibrationPattern": [
                0,
                250,
                250,
                250
              ],
              "lightColor": "#006D6F"
            },
            {
              "name": "chat",
              "importance": 4,
              "vibrationPattern": [
                0,
                250,
                250,
                250
              ],
              "lightColor": "#006D6F"
            },
            {
              "name": "payments",
              "importance": 5,
              "vibrationPattern": [
                0,
                250,
                250,
                250
              ],
              "lightColor": "#006D6F"
            }
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "MedSeva needs access to your media library to save reports and images.",
          "savePhotosPermission": "MedSeva needs permission to save files to your device.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
           "compileSdkVersion": 36,
"targetSdkVersion": 36,
            "minSdkVersion": 24,
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82102d25-9c8e-47f2-9ada-735685ea0aed"
      }
    }
  }
}
